[Unit]
Description=OpenClaw Cardputer bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cardputer
Group=cardputer
WorkingDirectory=/opt/cardputer/bridge
Environment=CARDPUTER_BRIDGE_CONFIG=/etc/cardputer/config.json
ExecStart=/usr/bin/node /opt/cardputer/bridge/src/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cardputer

[Install]
WantedBy=multi-user.target
