[Unit]
Description=OpenClaw Cardputer bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cardputer
Group=cardputer
WorkingDirectory=/opt/cardputer/bridge
Environment=CARDPUTER_BRIDGE_CONFIG=/etc/cardputer/config.json
ExecStart=/usr/bin/node /opt/cardputer/bridge/src/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=64
MemoryHigh=256M
MemoryMax=384M
CPUQuota=100%
ReadWritePaths=/var/lib/cardputer

[Install]
WantedBy=multi-user.target
