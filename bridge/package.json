{
  "name": "openclaw-s1-adv",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "mock-upstream": "node src/mock-upstream.mjs",
    "smoke": "node src/smoke.mjs",
    "smoke:realtime-contract": "node scripts/smoke-realtime-contract.mjs",
    "smoke:mininerva": "node src/mininerva-compat-smoke.mjs",
    "test:security": "node src/security-policy.test.mjs",
    "test:boundaries": "node --test src/security-boundaries.test.mjs src/turn-delivery-policy.test.mjs src/turn-correlation.test.mjs src/voice-upload-codec.test.mjs src/reply-language.test.mjs src/focus-audio.test.mjs",
    "gate:security": "node src/security-model-gate.mjs",
    "publish:firmware": "node scripts/publish-firmware.mjs",
    "enqueue:ota-install": "node scripts/enqueue-ota-install.mjs",
    "test:upstream": "node --test src/upstream-client.test.mjs",
    "test:install": "node --test src/install.test.mjs src/plugin-service.test.mjs src/firmware-automation.test.mjs",
    "setup": "node scripts/setup.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "ws": "^8.21.3",
    "json5": "2.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "ESP32-S3 AI companion for M5Stack Cardputer ADV: OpenClaw text and voice chat, Focus audio on SD, and optional firmware build and OTA updates.",
  "license": "MIT",
  "author": "Sergey Sizov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srg0/s1-adv.git",
    "directory": "bridge"
  },
  "homepage": "https://github.com/srg0/s1-adv",
  "bugs": {
    "url": "https://github.com/srg0/s1-adv/issues"
  },
  "files": [
    "index.mjs",
    "openclaw.plugin.json",
    "src/**/*.mjs",
    "!src/**/*.test.mjs",
    "!src/*smoke*.mjs",
    "!src/mock-upstream.mjs",
    "!src/fixtures.mjs",
    "!src/security-model-gate.mjs",
    "scripts/setup.mjs",
    "scripts/publish-firmware.mjs",
    "scripts/firmware-*.mjs",
    "config.example.json",
    "skills",
    "README.md",
    "TURN-OUTBOX.md",
    "LICENSE",
    "CREDITS.md",
    "assets/focus-audio/en",
    "assets/focus-audio/manifest.json"
  ],
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.7.2-beta.1",
      "minGatewayVersion": "2026.7.2-beta.1"
    },
    "build": {
      "openclawVersion": "2026.7.2-beta.1"
    }
  },
  "bin": {
    "s1-adv-setup": "./scripts/setup.mjs"
  },
  "keywords": [
    "esp32",
    "esp32-s3",
    "m5stack",
    "cardputer",
    "cardputer-adv",
    "ai-assistant",
    "openclaw",
    "voice",
    "ota"
  ]
}
